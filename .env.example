# Copy to `.env.local` (git-ignored). The DB harness and the AI Worker scripts load it.
# LOCAL DEVELOPMENT VALUES ONLY. Never commit real credentials; production uses secret storage.

# --- Database harness (scripts/db) --------------------------------------------------------
# supabase | pglite | auto (default: supabase when its DB answers, else PGlite). CI forces supabase.
JMOS_DB_MODE=auto
# Supabase local database started by `pnpm exec supabase start`.
JMOS_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- AI Worker (apps/ai-worker) -----------------------------------------------------------
# Must be the least-privileged `jmos_worker` role; the worker refuses privileged roles.
# The password below is the local-only value set by supabase/seed.sql.
JMOS_WORKER_DATABASE_URL=postgresql://jmos_worker:jmos-worker-local-dev-only@127.0.0.1:54322/postgres
JMOS_WORKER_ID=local-dev
JMOS_WORKER_POLL_SECONDS=2
JMOS_WORKER_LEASE_SECONDS=300
JMOS_WORKER_HEARTBEAT_SECONDS=15
JMOS_WORKER_LOG_LEVEL=INFO
